{
  "name": "umeed-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/auth-security.test.mts tests/dashboard-helpers.test.mts",
    "backend:dev": "npm --prefix server run dev",
    "backend:build": "npm --prefix server run build",
    "backend:start": "npm --prefix server run start",
    "backend:test": "npm --prefix server test",
    "staging:local": "npm --prefix server run staging:local"
  },
  "dependencies": {
    "@vercel/analytics": "1.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "15.5.29",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.32",
      "nanoid": "3.3.18",
      "source-map-js": "1.2.2"
    }
  }
