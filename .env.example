# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Use the private Express URL; production must use HTTPS.
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
NODE_ENV=development
# Production MongoDB URIs must enable TLS; local development may use loopback without TLS.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=umeed
FRONTEND_ORIGIN=http://localhost:3000
# Set to the exact trusted reverse-proxy hop count only when deployed behind one.
TRUST_PROXY=0
LOG_LEVEL=info
API_RATE_LIMIT_MAX=300
