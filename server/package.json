{
  "name": "umeed-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --env-file=../.env.local --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:indexes": "node --env-file=../.env.local --import tsx scripts/create-indexes.ts",
    "staging:local": "tsx scripts/local-staging.ts",
    "migration:json": "node --import tsx scripts/migrate-legacy-json.ts",
    "admin:provision": "node --env-file=../.env.local --import tsx scripts/provision-admin.ts",
    "test": "tsx --test"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "mongoose": "9.12.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.7.3"
  }
}
